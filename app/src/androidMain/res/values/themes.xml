<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Edge-to-edge theme:
      Transparent system bars let androidx.activity.enableEdgeToEdge() own the
      window insets on Android 15+ without falling back to the deprecated
      windowStatusBarColor / windowNavigationBarColor defaults from the parent.
    -->
    <style name="Theme.BookHound" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
