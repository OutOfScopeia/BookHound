<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AndroidProjectFolder>Platforms/Android/</AndroidProjectFolder>
    <iOSProjectFolder>Platforms/iOS/</iOSProjectFolder>
    <MacCatalystProjectFolder>Platforms/MacCatalyst/</MacCatalystProjectFolder>
    <WindowsProjectFolder>Platforms/Windows/</WindowsProjectFolder>
    <TizenProjectFolder>Platforms/Tizen/</TizenProjectFolder>
    <ProjectGuid>{dbe60a66-0c64-4103-ba7b-dd5633e04541}</ProjectGuid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
    <!-- Android emulator workaround -->
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
    <AndroidFastDeploymentType>None</AndroidFastDeploymentType>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- For per-project #if conditioning, currently not used -->
    <!-- <DefineConstants>$(DefineConstants);ANDROID</DefineConstants> -->
  </PropertyGroup>
  <PropertyGroup>
    <!-- .NET 10 MAUI TFMs -->
    <TargetFrameworks>
      net9.0-android;
      net9.0-ios;
      net9.0-maccatalyst;
      net9.0-windows10.0.19041.0
    </TargetFrameworks>
    <!-- VS design-time fallback -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BookHoundApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- <EnableDefaultItems>false</EnableDefaultItems> -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- App metadata -->
    <ApplicationTitle>BookHound</ApplicationTitle>
    <ApplicationId>com.cheekbytes.bookhound</ApplicationId>
    <ApplicationIdGuid>99FA52AF-7483-4E48-8A16-ED42DE49641C</ApplicationIdGuid>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- OS platform versions -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-android'">35.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <Target Name="VerifyAndroidFiles" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' == 'net9.0-android'">
    <Message Text="ANDROID COMPILE: @(Compile)" Importance="High" />
  </Target>
  <!-- Android files are completely ignored when conditioned with TargetFrameworkIdentifier. -->
  <!-- <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == 'android'"> -->
<!-- MauiProgram.Android.fs -> MauiProgram.fs -> MainApplication.fs -->
  <ItemGroup>
    <Compile Include="Camera.fs" />
    <!-- <Compile Include="$(AndroidProjectFolder)CameraPreview.fs"      Condition="'$(TargetFramework)' == 'net9.0-android'"/> -->
    <Compile Include="App.fs" />
    <Compile Include="$(AndroidProjectFolder)CameraAnalyzer.fs"      Condition="'$(TargetFramework)' == 'net9.0-android'"/>
    <Compile Include="$(AndroidProjectFolder)CameraStartup.fs"       Condition="'$(TargetFramework)' == 'net9.0-android'"/>
    <Compile Include="$(AndroidProjectFolder)CameraService.fs"       Condition="'$(TargetFramework)' == 'net9.0-android'"/>
    <Compile Include="$(AndroidProjectFolder)MainActivity.fs"        Condition="'$(TargetFramework)' == 'net9.0-android'"/>
    <Compile Include="$(AndroidProjectFolder)MauiProgram.Android.fs" Condition="'$(TargetFramework)' == 'net9.0-android'"/>
    <Compile Include="MauiProgram.fs" />
    <Compile Include="$(AndroidProjectFolder)MainApplication.fs"     Condition="'$(TargetFramework)' == 'net9.0-android'"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fabulous" Version="2.*" />
    <PackageReference Include="Fabulous.MauiControls" Version="8.*" />
    <PackageReference Include="FSharp.Core" Version="10.*" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.*" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.*" />
  </ItemGroup>
  <!-- Android -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
    <!-- <AndroidGenerateManifest>false</AndroidGenerateManifest> -->
    <AndroidManifestPermission Include="android.permission.CAMERA" />
    <AndroidResource Include="$(AndroidProjectFolder)Resources/**/*" />
    <AndroidAsset Include="$(AndroidProjectFolder)Assets/**/*" />
    <AndroidManifest Include="$(AndroidProjectFolder)AndroidManifest.xml" />

    <PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.3.4" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.3.4" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.3.4" />
    <PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.3.4" />
  </ItemGroup>
</Project>

<!-- In MAUI + F#: (this is a nice theory, but completely wrong for this .fsproj)
- Use TargetFrameworkIdentifier == android for code
- Use TargetFramework == netX-android for resources / packaging
- Never mix them for .fs files -->