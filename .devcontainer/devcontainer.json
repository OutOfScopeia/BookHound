{
    "name": "Fabulous F# for Dev",
    "dockerComposeFile": "../Build/docker-compose.yml",
    "service": "bookhound",
    "workspaceFolder": "/workspaces",
    "runServices": [
        "bookhound"
    ],
    "postCreateCommand": "dotnet workload restore ${containerWorkspaceFolder}/BookHoundApp.sln",
    "customizations": {
        "vscode": {
            "extensions": [
                "Ionide.Ionide-fsharp",
                "ms-vscode-remote.remote-containers",
                "nromanov.dotnet-meteor"
            ]
        }
    }
}