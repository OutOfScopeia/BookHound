<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AndroidProjectFolder>Platforms/Android/</AndroidProjectFolder>
    <iOSProjectFolder>Platforms/iOS/</iOSProjectFolder>
    <MacCatalystProjectFolder>Platforms/MacCatalyst/</MacCatalystProjectFolder>
    <WindowsProjectFolder>Platforms/Windows/</WindowsProjectFolder>
    <TizenProjectFolder>Platforms/Tizen/</TizenProjectFolder>
    <ProjectGuid>{dbe60a66-0c64-4103-ba7b-dd5633e04541}</ProjectGuid>
  </PropertyGroup>
  <!-- Android emulator workaround -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
    <AndroidFastDeploymentType>None</AndroidFastDeploymentType>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst;net8.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Design-time default for VS -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BookHoundApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- Display name -->
    <ApplicationTitle>BookHound</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.cheekbytes.bookhound</ApplicationId>
    <ApplicationIdGuid>99FA52AF-7483-4E48-8A16-ED42DE49641C</ApplicationIdGuid>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- OS platform versions per TFM -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-android'">34.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- Tizen only really makes sense if you add a net8.0-tizen TFM; leave it inert for now -->
  </PropertyGroup>
  <!-- Shared F# code -->
  <!-- Android -->
  <!-- iOS -->
  <!-- MacCatalyst -->
  <!-- Windows -->
  <!-- Tizen (only meaningful if you later add net8.0-tizen to TargetFrameworks) -->
  <!-- Packages -->
  <ItemGroup>
    <Compile Include="App.fs" />
    <Compile Include="MauiProgram.fs" />
    <AndroidResource Include="$(AndroidProjectFolder)Resources\**\*" />
    <AndroidAsset Include="$(AndroidProjectFolder)Assets\**\*" />
    <AndroidManifest Include="$(AndroidProjectFolder)AndroidManifest.xml" />
    <Compile Include="$(AndroidProjectFolder)MainActivity.fs" />
    <Compile Include="$(AndroidProjectFolder)MainApplication.fs" />
    <None Include="$(iOSProjectFolder)Info.plist" LogicalName="Info.plist" />
    <Compile Include="$(iOSProjectFolder)AppDelegate.fs" />
    <Compile Include="$(iOSProjectFolder)Program.fs" />
    <None Include="$(MacCatalystProjectFolder)Info.plist" LogicalName="Info.plist" />
    <Compile Include="$(MacCatalystProjectFolder)AppDelegate.fs" />
    <Compile Include="$(MacCatalystProjectFolder)Program.fs" />
    <Manifest Include="$(WindowsProjectFolder)app.manifest" />
    <AppxManifest Include="$(WindowsProjectFolder)Package.appxmanifest" />
    <Compile Include="$(WindowsProjectFolder)App.fs" />
    <Compile Include="$(WindowsProjectFolder)Main.fs" />
    <PackageReference Include="FSharp.Maui.WinUICompat" Version="1.1.0" />
    <TizenManifestFile Include="$(TizenProjectFolder)tizen-manifest.xml" />
    <Compile Include="$(TizenProjectFolder)Main.fs" />
    <PackageReference Include="Fabulous" Version="2.4.0" />
    <PackageReference Include="Fabulous.MauiControls" Version="8.0.5" />
    <PackageReference Include="FSharp.Core" Version="8.0.100" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.3" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.3" />
    <None Include=".gitattributes" />
    <None Include=".gitignore" />
    <None Include="Directory.Build.targets" />
    <None Include="global.json" />
    <None Include="README.md" />
  </ItemGroup>
</Project>